<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net6.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>Allpaypayz.Sdk</PackageId>
    <Version>0.1.0</Version>
    <Authors>Allpaypays</Authors>
    <Description>Official Allpaypayz API v4 SDK for .NET.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/allpaypayz/allpaypayz-sdk-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/allpaypayz/allpaypayz-sdk-dotnet</RepositoryUrl>
    <PackageTags>allpaypayz;payments;payouts;p2p;webhook;sdk</PackageTags>
    <RootNamespace>Allpaypayz</RootNamespace>
    <AssemblyName>Allpaypayz.Sdk</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
